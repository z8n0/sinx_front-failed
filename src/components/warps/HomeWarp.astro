---
import { HouseSimpleIcon } from "@phosphor-icons/react"
const { isSelected = false } = Astro.props;
let warpClasses = "warp-btn";
if (isSelected) {
  warpClasses += " warp-btn-selected";
} else {
  warpClasses += " warp-btn-redirectable";
}
---
  <div class="home-warp">
{
  !isSelected && (
        <a href="/">
        <button
          class={warpClasses}
        >
          <HouseSimpleIcon size={24} />
        </button>
        </a>
  )
}
{
  isSelected && (
        <button
          class={warpClasses}
        >
           <HouseSimpleIcon size={24} />
        </button>
  )
}
      </div>
