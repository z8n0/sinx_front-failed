---
import { UploadSimpleIcon } from "@phosphor-icons/react"
const { isSelected = false } = Astro.props;
let warpClasses = "warp-btn";
if (isSelected) {
  warpClasses += " warp-btn-selected";
} else {
  warpClasses += " warp-btn-redirectable";
}
---

<div class="upload-warp">
  {
      !isSelected && (
        <a href="/upload" style="text-decoration: none;">
        <button class={warpClasses} onclick="togglePanel()" aria-label="اپلود">
        <UploadSimpleIcon size={24} />
  </button>
</a>        
      )
    }
    {
      isSelected && (
        <button class={warpClasses} onclick="togglePanel()" aria-label="اپلود">
        <UploadSimpleIcon size={24} />
  </button>
      )
    }
</div>
