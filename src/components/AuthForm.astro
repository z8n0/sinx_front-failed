<div class="auth-card">
  <form class="auth" action="">
    <p class="auth-title">Login/Register</p>
    
    <p class="auth-p auth-p-user" id="label-user">Username</p>
    <input maxlength="32" name="" id="input-user" class="user auth-input transition-transform duration-200 focus:scale-105 focus:ring-2 focus:ring-(--btn-bg-hover) focus:outline-none">
    
    <p class="auth-p auth-p-password" id="label-password">Password</p>
    <input maxlength="32" type="password" name="" id="input-password" class="password auth-input transition-transform duration-200 focus:scale-105 focus:ring-2 focus:ring-(--btn-bg-hover) focus:outline-none">
    
    <button class="confirm">Submit</button>
  </form>
</div>