---
import CommentButton from "./buttons/CommentButton"
import LikeButton from "./buttons/LikeButton"
---
<div class="feed">
      <div class="msg">
        <div class="msg-header">
          <div class="ch-bar">
            <img
              class="ch-av"
              src="/assets/28e8d5e0-7144-4db6-b753-44e8d3f37e93.png"
              alt="avatar" />
            <div class="ch-data">
              <span class="ch-nm">ruxa</span>
              <span class="msg-date">۱۴۰۵/۰۱/۱۸ ۰۶:۴۵</span>
            </div>
          </div>
          <div class="msg-title">تست تایتل</div>
        </div>
        <div class="msg-body">
          <div class="msg-media">
            <img src="/assets/image copy.png" alt="avatar" />
          </div>

          <div class="msg-text">تست متن فارسی.</div>

          <div class="msg-foot">

            <div class="social-bar">
              <div class="vote-group">
                <LikeButton client:load />
              </div>
              <div class="comment-group">
                <CommentButton client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>