---
import {
  SunDimIcon,
  MoonStarsIcon,
  DesktopIcon,
  PaletteIcon,
} from "@phosphor-icons/react";
---

<div class="panel-section" id="section-theme" hidden>
  <h2 class="panel-title">تم</h2>
  <div class="panel-content-inner">
    <div class="input-group theme-dropdown-group">
      <label class="input-label">انتخاب تم</label>

      <button
        class="theme-dropdown-trigger"
        id="themeDropdownTrigger"
        type="button"
      >
        <span class="trigger-icon" id="selectedThemeIcon"></span>
        <span class="trigger-text" id="selectedThemeText"></span>
        <svg class="trigger-arrow" viewBox="0 0 24 24" fill="none">
          <path
            d="M6 9l6 6 6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <div class="theme-dropdown-list" id="themeDropdownList">
        <button
          class="dropdown-item"
          data-value="light"
          data-icon="sun"
          type="button"
          id="light-theme-btn"
        >
          <span class="item-icon"><SunDimIcon size={20} weight="fill" /></span>
          <span class="item-text">لابت</span>
        </button>

        <button
          class="dropdown-item"
          data-value="dark"
          id="dark-theme-btn"
          data-icon="moon"
          type="button"
        >
          <span class="item-icon"
            ><MoonStarsIcon size={20} weight="fill" /></span
          >
          <span class="item-text">دارک</span>
        </button>
      </div>
    </div>

    <div class="theme-preview-cards">
      <div class="theme-preview-card" data-theme="light">
        <div class="preview-header light-preview"></div>
        <div class="preview-body">
          <div class="preview-line"></div>
          <div class="preview-line short"></div>
        </div>
        <span class="preview-name">لایت</span>
      </div>
      <div class="theme-preview-card" data-theme="dark">
        <div class="preview-header dark-preview"></div>
        <div class="preview-body dark-body">
          <div class="preview-line"></div>
          <div class="preview-line short"></div>
        </div>
        <span class="preview-name">دارک</span>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener("astro:page-load", () => {
  const THEME_KEY = "theme";

  const trigger = document.getElementById("themeDropdownTrigger");
  const list = document.getElementById("themeDropdownList");
  const triggerText = document.getElementById("selectedThemeText");
  const triggerIcon = document.getElementById("selectedThemeIcon");

  const items = Array.from(
    list?.querySelectorAll(".dropdown-item") ?? []
  );

  function getTheme() {
    return document.documentElement.getAttribute("data-theme") || "light";
  }

  function setTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);

    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch (e) {}

    syncThemeUI();
  }

  function initTheme() {
    let saved = "light";

    try {
      saved = localStorage.getItem(THEME_KEY) || "light";
    } catch (e) {}

    document.documentElement.setAttribute("data-theme", saved);
  }

  function syncThemeUI() {
    const theme = getTheme();

    items.forEach((item) => {
      const value = item.dataset.value;

      const isActive = value === theme;
      item.classList.toggle("active", isActive);

      if (isActive) {
        const text = item.querySelector(".item-text")?.textContent;

        if (triggerText) {
          triggerText.textContent = text || "";
        }

        const icon = item.querySelector(".item-icon");
        if (icon && triggerIcon) {
          triggerIcon.innerHTML = "";
          triggerIcon.appendChild(icon.cloneNode(true));
        }
      }
    });
  }

  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    list?.classList.toggle("open");
    trigger.classList.toggle("open");
  });

  document.addEventListener("click", () => {
    list?.classList.remove("open");
    trigger?.classList.remove("open");
  });

  items.forEach((item) => {
    item.addEventListener("click", () => {
      const value = item.dataset.value;

      if (value) {
        setTheme(value);
      }

      list?.classList.remove("open");
      trigger?.classList.remove("open");
    });
  });

  initTheme();
  syncThemeUI();
});
</script>
