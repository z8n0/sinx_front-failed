---
import { CameraIcon } from "@phosphor-icons/react";
---

<div class="panel-section" id="section-profile">
  <h2 class="panel-title">پروفایل</h2>
  <div class="panel-content-inner">
    <div class="profile-header">
      <input type="file" id="bannerUpload" hidden />
      <div class="profile-banner" id="profileBanner">
        <img src="/assets/image.png" alt="banner" class="banner-img" />
        <button class="banner-edit-btn" id="bannerEditBtn" type="button">
          <CameraIcon size={16} weight="bold" />
        </button>
      </div>

      <div class="profile-avatar-wrapper">
        <input type="file" id="avatarUpload" hidden />
        <div class="profile-avatar" id="profileAvatar">
          <img
            src="/assets/28e8d5e0-7144-4db6-b753-44e8d3f37e93.png"
            alt="avatar"
            class="avatar-img"
          />
          <button class="avatar-edit-btn" id="avatarEditBtn" type="button">
            <CameraIcon size={16} weight="bold" />
          </button>
        </div>
      </div>
    </div>

    <div class="profile-info">
      <div class="profile-name-row">
        <h3 class="profile-displayname" id="profileDisplayName">ruxa</h3>
        <span class="profile-username" id="profileUserTag">@ruxa</span>
      </div>
      <p class="profile-bio" id="profileBioText">دینو کونیه</p>
    </div>

    <div class="profile-edit-form">
      <div class="input-group">
        <label class="input-label">نام نمایشی</label>
        <input
          type="text"
          class="input-field"
          placeholder="نام نمایشی خود را وارد کنید"
          id="profile-displayname-input"
          value="ruxa"
        />
      </div>

      <div class="input-group">
        <label class="input-label">یوزرنیم</label>
        <div class="input-prefix-wrapper">
          <span class="input-prefix">@</span>
          <input
            type="text"
            class="input-field with-prefix"
            placeholder="یوزرنیم"
            id="profile-username-input"
            value="ruxa"
          />
        </div>
      </div>

      <div class="input-group">
        <label class="input-label">بیوگرافی</label>
        <textarea
          class="input-field textarea-field"
          placeholder="درباره خودتان بنویسید..."
          rows="3"
          id="profile-bio-input"></textarea>
      </div>

      <button class="btn btn-primary" id="profile-save"> ذخیره تغییرات </button>
    </div>
  </div>

</div>
<script>
  import Cropper from "cropperjs";
  import "cropperjs/dist/cropper.css";

  document.addEventListener("DOMContentLoaded", () => {
    const avatarInput = document.getElementById("avatarUpload");
    const bannerInput = document.getElementById("bannerUpload");
    const avatarImg = document.querySelector(".avatar-img");
    const bannerImg = document.querySelector(".banner-img");
    const avatarBtn = document.getElementById("avatarEditBtn");
    const bannerBtn = document.getElementById("bannerEditBtn");

    const cropperModal = document.getElementById("cropperModal");
    const cropperImage = document.getElementById("cropperImage");
    const cropperTitle = document.getElementById("cropperTitle");
    const cropperCancel = document.getElementById("cropperCancel");
    const cropperClose = document.getElementById("cropperClose");
    const cropperConfirm = document.getElementById("cropperConfirm");

    if (!cropperModal || !cropperImage || !cropperTitle) return;

    let cropper = null;
    let currentTarget = "avatar";
    let objectUrl = null;

    const CROP_MODES = {
      avatar: {
        aspectRatio: 1,
        title: "ویرایش آواتار",
        width: 512,
        height: 512,
      },
      banner: {
        aspectRatio: 6.39 / 1,
        title: "ویرایش بنر",
        width: 1280,
        height: 720,
      },
    };

    function openCropper(mode) {
      currentTarget = mode;
      const config = CROP_MODES[mode];

      cropperTitle.textContent = config.title;
      cropperModal.classList.add("open");
      document.body.style.overflow = "hidden";
    }

    function closeCropper() {
      cropperModal.classList.remove("open");
      document.body.style.overflow = "";

      if (cropper) {
        cropper.destroy();
        cropper = null;
      }

      if (objectUrl) {
        URL.revokeObjectURL(objectUrl);
        objectUrl = null;
      }
    }

    function initCropper(src, mode) {
      const config = CROP_MODES[mode];

      if (cropper) cropper.destroy();

      cropperImage.src = src;

      cropper = new Cropper(cropperImage, {
        aspectRatio: config.aspectRatio,
        viewMode: 1,
        dragMode: "move",
        autoCropArea: 0.9,
        background: false,
      });
    }

    function applyCrop() {
      if (!cropper) return;

      const config = CROP_MODES[currentTarget];

      const canvas = cropper.getCroppedCanvas({
        width: config.width,
        height: config.height,
      });

      canvas.toBlob((blob) => {
        if (!blob) return;

        const url = URL.createObjectURL(blob);

        if (currentTarget === "avatar" && avatarImg) {
          avatarImg.src = url;
        }

        if (currentTarget === "banner" && bannerImg) {
          bannerImg.src = url;
        }

        closeCropper();
      });
    }

    function handleFile(file, mode) {
      if (!file) return;

      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(file);

      // ✅ GIF handling
      if (file.type === "image/gif") {
        if (mode === "avatar" && avatarImg) {
          avatarImg.src = objectUrl;
        }

        if (mode === "banner" && bannerImg) {
          bannerImg.src = objectUrl;
        }

        return;
      }

      // ✅ normal images
      if (!file.type.startsWith("image/")) return;

      openCropper(mode);
      initCropper(objectUrl, mode);
    }

    avatarBtn?.addEventListener("click", () => avatarInput?.click());
    bannerBtn?.addEventListener("click", () => bannerInput?.click());

    avatarInput?.addEventListener("change", (e) => {
      const file = e.target.files?.[0];
      handleFile(file, "avatar");
    });

    bannerInput?.addEventListener("change", (e) => {
      const file = e.target.files?.[0];
      handleFile(file, "banner");
    });

    cropperCancel?.addEventListener("click", closeCropper);
    cropperClose?.addEventListener("click", closeCropper);
    cropperConfirm?.addEventListener("click", applyCrop);

    cropperModal
      .querySelector(".cropper-backdrop")
      ?.addEventListener("click", closeCropper);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && cropperModal.classList.contains("open")) {
        closeCropper();
      }
    });
  });
</script>